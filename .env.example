# Clerk (https://dashboard.clerk.com) - create an application and copy the keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (run `npx convex dev` once and it writes this for you)
NEXT_PUBLIC_CONVEX_URL=

# --- Set these in the Convex dashboard (Settings -> Environment Variables), not in .env.local ---
# Issuer domain of your Clerk "convex" JWT template, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# Signing secret of the Clerk webhook that points at https://<deployment>.convex.site/clerk-webhook
CLERK_WEBHOOK_SECRET=
# Optional: "true" gives every new user sample friends and conversations (useful for demos)
SEED_DEMO_DATA=
# Optional: enables transcripts for recorded videos (Groq Whisper). Leave empty to skip transcripts.
GROQ_API_KEY=
